import Image from "next/image";
import Link from "next/link";
import { ChevronLeft, ShieldCheck, Truck } from "lucide-react";
import { createClient } from "@/lib/supabase/server";
import OrderForm from "@/components/OrderForm";
import StorefrontNav from "@/components/storefront/StorefrontNav";
import StorefrontFooter from "@/components/storefront/StorefrontFooter";

export default async function ProductPage({ params }: { params: Promise<{ id: string }> }) {
  const { id } = await params;
  const supabase = await createClient();
  const { data: product } = await supabase.from("products").select("*").eq("id", Number(id)).maybeSingle();
  if (!product) return <div className="min-h-screen bg-[#fbfaf8]"><StorefrontNav /><main className="mx-auto flex min-h-[60vh] max-w-7xl flex-col items-center justify-center px-5 text-center"><p className="text-sm font-semibold uppercase tracking-[.18em] text-amber-800">Not found</p><h1 className="mt-4 text-4xl font-black tracking-[-.04em]">This piece is no longer available.</h1><Link href="/" className="mt-7 inline-flex rounded-full bg-stone-950 px-6 py-3 text-sm font-semibold text-white">Return to collection</Link></main><StorefrontFooter /></div>;
  return <div className="min-h-screen bg-[#fbfaf8] text-stone-950"><StorefrontNav /><main className="mx-auto max-w-7xl px-5 py-8 lg:px-8 lg:py-12"><Link href="/" className="inline-flex items-center gap-1 text-sm font-semibold text-stone-600 transition hover:text-stone-950"><ChevronLeft size={17} /> Back to collection</Link><div className="mt-7 grid gap-10 lg:grid-cols-[1.05fr_.95fr] lg:gap-16"><div className="relative aspect-[4/5] overflow-hidden rounded-[2rem] bg-stone-100">{product.image ? <Image src={product.image} alt={product.name} fill priority sizes="(max-width: 1024px) 100vw, 55vw" className="object-cover" /> : <div className="flex h-full items-center justify-center text-stone-400">Image coming soon</div>}<span className="absolute left-5 top-5 rounded-full bg-white/90 px-3 py-1.5 text-xs font-semibold backdrop-blur">ORVEN LUX selection</span></div><div className="lg:pt-4"><p className="text-sm font-semibold uppercase tracking-[.16em] text-amber-800">The collection</p><h1 className="mt-3 text-4xl font-black tracking-[-.05em] sm:text-5xl">{product.name}</h1><p className="mt-5 text-2xl font-semibold">{product.price.toLocaleString()} DA</p><p className="mt-7 max-w-xl text-base leading-7 text-stone-600">{product.description || "A considered piece selected for its effortless detail and everyday usefulness."}</p><div className="my-8 grid gap-3 border-y border-stone-200 py-6 text-sm text-stone-600"><span className="flex items-center gap-3"><Truck size={18} className="text-emerald-700" /> Home or delivery-office shipping available</span><span className="flex items-center gap-3"><ShieldCheck size={18} className="text-emerald-700" /> Final total confirmed before ordering</span></div><OrderForm productId={product.id} productPrice={product.price} /></div></div></main><StorefrontFooter /></div>;
}